---
type Props = {
  value: string;
  label: string;
};

const { value, label } = Astro.props;
---

<article class="metric">
  <span class="metric__status">VERIFIED_SYSTEM</span>
  <strong>{value}</strong>
  <span class="metric__label">{label}</span>
</article>

<style>
  .metric {
    min-width: 0;
    padding: var(--space-4) var(--space-4) var(--space-3);
    border: var(--border-1) solid var(--border-subtle);
    background: var(--surface-subtle);
  }

  .metric__status,
  .metric__label {
    display: block;
    font: 500 var(--type-label) / 1.4 var(--font-mono);
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .metric__status { color: var(--text-secondary); }

  strong {
    display: block;
    margin: var(--space-2) 0;
    font: 400 2.65rem / 0.95 var(--font-display);
  }

  .metric__label {
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--accent-default);
    color: var(--text-secondary);
  }
</style>
