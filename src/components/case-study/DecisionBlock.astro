---
type Props = {
  label: string;
  decision: string;
  rationale: string;
  constraint: string;
};

const { label, decision, rationale, constraint } = Astro.props;
---

<article class="decision-block">
  <span>{label}</span>
  <h3>{decision}</h3>
  <p>{rationale}</p>
  <small>{constraint}</small>
  <i aria-hidden="true"></i>
</article>

<style>
  .decision-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border: var(--border-1) solid var(--border-strong);
    background: var(--surface-canvas);
  }

  span {
    color: var(--text-accent);
    font: 500 var(--type-label) / 1.45 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  h3 {
    max-width: 58rem;
    margin: 0;
    font: 400 1.875rem / 1.2 var(--font-display);
  }

  p,
  small { max-width: 58rem; margin: 0; }
  p { font-size: 1rem; line-height: 1.5; }
  small { color: var(--text-secondary); font-size: 0.875rem; line-height: 1.5; }

  i {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--accent-default);
  }
</style>
