---
type Props = {
  label: string;
  evidence: string;
  detail: string;
};

const { label, evidence, detail } = Astro.props;
---

<article class="evidence-block">
  <span>{label}</span>
  <p>{evidence}</p>
  <small>{detail}</small>
  <i aria-hidden="true"></i>
</article>

<style>
  .evidence-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-5);
    border: var(--border-1) solid var(--border-default);
    background: var(--surface-subtle);
  }

  span,
  small {
    font: 500 var(--type-label) / 1.45 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  span { color: var(--text-accent); }

  p {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.55;
  }

  small {
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.5;
    text-transform: none;
  }

  i {
    display: block;
    width: 100%;
    height: 2px;
    margin-top: auto;
    background: var(--accent-default);
  }
</style>
