---
type Props = {
  src: string;
  alt: string;
  caption: string;
  size?: "hero" | "banner" | "iteration";
  position?: "left" | "center" | "right";
  loading?: "eager" | "lazy";
};

const { src, alt, caption, size = "banner", position = "center", loading = "lazy" } = Astro.props;
const optimizedSrc = src.endsWith(".png") ? src.replace(/\.png$/, ".webp") : undefined;
---

<figure class:list={["case-media", `case-media--${size}`, `case-media--${position}`]}>
  <div>
    <picture>
      {optimizedSrc && <source srcset={optimizedSrc} type="image/webp" />}
      <img
        src={src}
        alt={alt}
        width="1672"
        height="941"
        loading={loading}
        decoding="async"
        fetchpriority={loading === "eager" ? "high" : "auto"}
      />
    </picture>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .case-media {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    border: var(--border-1) solid var(--border-subtle);
    background: var(--surface-canvas);
  }

  .case-media > div {
    height: 225px;
    overflow: hidden;
    border: var(--border-1) solid var(--border-strong);
  }

  .case-media--hero > div { height: 225px; }
  .case-media--iteration > div { height: 300px; }

  picture { display: block; width: 100%; height: 100%; }
  img { width: 100%; height: 100%; object-fit: cover; }
  .case-media--left img { object-position: left center; }
  .case-media--right img { object-position: right center; }

  figcaption {
    padding: 0 var(--space-4) var(--space-4);
    color: var(--text-secondary);
    font: 500 0.625rem / 1.5 var(--font-mono);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  @media (max-width: 767px) {
    .case-media--hero > div { height: 210px; }
    .case-media--banner > div,
    .case-media--iteration > div { height: 210px; }
  }
</style>
