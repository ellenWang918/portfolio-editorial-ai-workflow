---
import PortfolioAction from "../components/PortfolioAction.astro";
import SystemLabel from "../components/SystemLabel.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Page not found — Ellen Wang"
  description="The requested portfolio page could not be found. Return to Ellen Wang’s product design portfolio."
>
  <main id="main-content" class="not-found" tabindex="-1">
    <SystemLabel tone="accent">Error_404 / Route unavailable</SystemLabel>
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1>This page is outside the system.</h1>
    <p>The address may have changed, or the case study is not published yet.</p>
    <PortfolioAction href="/" label="Return to portfolio" />
  </main>
</SiteLayout>

<style>
  .not-found {
    display: grid;
    min-height: 100svh;
    align-content: center;
    justify-items: start;
    gap: var(--space-5);
    width: min(100% - 3rem, 64rem);
    margin: 0 auto;
    padding: var(--space-10) 0;
  }

  .not-found__code {
    margin: 0;
    color: var(--text-accent);
    font: 400 clamp(8rem, 24vw, 18rem) / 0.72 var(--font-display);
  }

  h1 {
    max-width: 50rem;
    margin: var(--space-5) 0 0;
    font: 400 clamp(3rem, 8vw, 5.5rem) / 0.96 var(--font-display);
    letter-spacing: -0.03em;
  }

  main > p:not(.not-found__code) {
    max-width: 34rem;
    margin: 0 0 var(--space-5);
    color: var(--text-secondary);
    font-size: 1.125rem;
    line-height: 1.55;
  }
</style>
